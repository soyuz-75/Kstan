# Postgres connection string. Local: postgres://kstan:kstan@localhost:5432/kstan
# Production: the pooled connection string from Neon or Supabase.
DATABASE_URL=postgres://kstan:kstan@localhost:5432/kstan

# Canonical origin, no trailing slash. Used for canonical URLs, sitemap, JSON-LD and OG images.
SITE_URL=https://k-stan.vn.ua

# Telegram bot that posts new bookings into the staff chat. Leave empty to log to the console instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Resend (https://resend.com) for staff and guest emails. Leave empty to log to the console instead.
RESEND_API_KEY=
# Where staff notifications go (comma-separated for several addresses).
NOTIFY_EMAIL=
# Sender address on a domain verified in Resend.
EMAIL_FROM="Козацький Стан <booking@k-stan.vn.ua>"

# Optional public contact email shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional Cloudflare Turnstile. When both are set, booking forms require the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
